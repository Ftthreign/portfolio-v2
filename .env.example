# Domain & Caddy SSL
DOMAIN_NAME=yourdomain.com
CADDY_EMAIL=admin@yourdomain.com

# General
ENVIRONMENT=development
PORT=8080

# Database (PostgreSQL)
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=portfolio_secret
POSTGRES_DB=portfolio_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://portfolio_user:portfolio_secret@localhost:5432/portfolio_db?sslmode=disable

# Auth (JWT)
JWT_SECRET=super-secret-jwt-key-change-in-production-123456789

# Cloudflare R2 (S3-compatible) Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Frontend
PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080
