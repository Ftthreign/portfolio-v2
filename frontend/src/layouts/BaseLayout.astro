---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fadhil — Fullstack Engineer & Systems Builder',
  description = 'Portfolio & Journal of a Fullstack Developer focusing on craft, clarity, Go, TypeScript, and clean systems architecture.',
} = Astro.props;
---

<!json>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-cream text-charcoal font-sans antialiased selection:bg-terracotta selection:text-white min-h-screen flex flex-col">
    <!-- Editorial Backdrop Blur Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-cream/80 border-b border-charcoal/10 transition-all duration-200">
      <div class="max-w-container mx-auto px-margin-mobile md:px-gutter h-16 flex items-center justify-between">
        <a href="/" class="font-serif font-bold text-xl tracking-tight hover:text-terracotta transition-colors">
          Ftthreign<span class="text-terracotta">.</span>
        </a>

        <nav class="hidden md:flex items-center space-x-8 text-sm font-medium tracking-wide">
          <a href="/#about" class="hover:text-terracotta transition-colors">Tentang</a>
          <a href="/projects" class="hover:text-terracotta transition-colors">Proyek</a>
          <a href="/blog" class="hover:text-terracotta transition-colors">Blog</a>
          <a href="/#skills" class="hover:text-terracotta transition-colors">Keahlian</a>
          <a href="/#contact" class="hover:text-terracotta transition-colors">Kontak</a>
        </nav>

        <a
          href="/cms/login"
          class="text-xs uppercase tracking-wider font-semibold border border-charcoal/20 px-3 py-1.5 rounded hover:bg-charcoal hover:text-cream transition-all"
        >
          CMS Admin
        </a>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Editorial Footer -->
    <footer class="border-t border-charcoal/10 bg-cream-highest/30 py-12 mt-section-gap">
      <div class="max-w-container mx-auto px-margin-mobile md:px-gutter flex flex-col md:flex-row justify-between items-center gap-6">
        <div>
          <p class="font-serif font-semibold text-lg">Artisanal Logic & Design</p>
          <p class="text-xs text-charcoal-variant mt-1">
            Built with Astro, Go, PostgreSQL, Cloudflare R2, Bun & GSAP.
          </p>
        </div>
        <p class="text-xs text-charcoal-variant">
          &copy; {new Date().getFullYear()} Fadhil. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>
