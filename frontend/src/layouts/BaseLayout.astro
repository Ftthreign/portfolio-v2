---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Fadhil Abdul Fattah — Product Designer & Fullstack Engineer",
  description = "Passionate about creating intuitive digital experiences that connect users with value.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth overflow-x-clip w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Google Fonts Direct Stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Early Theme Script to prevent FOUC -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-surface dark:bg-[#0b1120] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans relative overflow-x-clip w-full max-w-full transition-colors duration-400">
    <div class="custom-cursor hidden md:block"></div>
    <div class="custom-cursor-follower hidden md:block"></div>

    <Navbar />

    <main class="flex-grow pt-24 md:pt-28 w-full max-w-full">
      <slot />
    </main>

    <Footer />

    <script>
      import { initCustomCursor, initScrollReveals } from '../utils/gsap';

      document.addEventListener('DOMContentLoaded', () => {
        initCustomCursor();
        initScrollReveals();
      });

      document.addEventListener('astro:page-load', () => {
        initCustomCursor();
        initScrollReveals();
      });
    </script>
  </body>
</html>
