---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchProjects } from '../../services/api';

const projects = await fetchProjects();
---

<BaseLayout title="Manage Projects — CMS Admin Portal">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 font-mono">CMS ADMIN PORTAL</span>
        <h1 class="font-serif text-3xl font-bold text-slate-900 mt-1">Manage Projects</h1>
      </div>
      <a href="/cms" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition-colors">
        ← Back to Overview
      </a>
    </div>

    <!-- Create Project Form Card -->
    <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card mb-12 space-y-6">
      <h2 class="font-serif text-xl font-bold text-slate-900">Add New Case Study</h2>
      
      <form action="http://localhost:8080/cms/projects/save" method="POST" class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Project Title *</label>
            <input type="text" name="title" required placeholder="Aether Design System" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Category</label>
            <input type="text" name="category" placeholder="Design System / Product Design" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Short Description *</label>
          <input type="text" name="short_description" required placeholder="A multi-platform enterprise design system..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Full Overview HTML/Text *</label>
          <textarea name="full_description" rows="3" required placeholder="Detailed breakdown of problem, solution, and tokens..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Cover Image URL</label>
            <input type="url" name="cover_image_url" placeholder="https://images.unsplash.com/..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Tech Stack (comma separated)</label>
            <input type="text" name="tech_stack" placeholder="Figma, React, TailwindCSS, GSAP" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Live URL</label>
            <input type="url" name="live_url" placeholder="https://aether.elianross.design" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
        </div>

        <input type="hidden" name="published" value="true" />
        <button type="submit" class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-emerald-600 text-white font-bold text-xs shadow-md transition-colors">
          Save Project Case Study
        </button>
      </form>
    </div>

    <!-- Existing Projects List -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-serif text-lg font-bold text-slate-900">Existing Case Studies ({projects.length})</h2>
      </div>

      <div class="divide-y divide-slate-100">
        {projects.map((p) => (
          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              {p.cover_image_url && (
                <img src={p.cover_image_url} alt={p.title} class="w-14 h-14 rounded-xl object-cover border border-slate-200 shrink-0" />
              )}
              <div>
                <h3 class="font-serif font-bold text-slate-900 text-base">{p.title}</h3>
                <p class="text-xs text-slate-500 line-clamp-1">{p.short_description}</p>
                <div class="flex items-center gap-2 mt-1">
                  <span class="text-[10px] font-mono text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                    /{p.slug}
                  </span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <a href={`/projects/${p.slug}`} target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold">
                Preview ↗
              </a>
              <form action="http://localhost:8080/cms/projects/delete" method="POST" class="inline">
                <input type="hidden" name="id" value={p.id} />
                <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 text-xs font-semibold">
                  Delete
                </button>
              </form>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
