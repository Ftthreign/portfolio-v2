---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchBlogPosts } from '../../services/api';

const posts = await fetchBlogPosts();
---

<BaseLayout title="Manage Blog Posts — CMS Admin Portal">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 font-mono">CMS ADMIN PORTAL</span>
        <h1 class="font-serif text-3xl font-bold text-slate-900 mt-1">Manage Journal & Blog Articles</h1>
      </div>
      <a href="/cms" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition-colors">
        ← Back to Overview
      </a>
    </div>

    <!-- Create Article Form Card -->
    <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card mb-12 space-y-6">
      <h2 class="font-serif text-xl font-bold text-slate-900">Write New Article</h2>

      <form action="http://localhost:8080/cms/blog/save" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Article Title *</label>
          <input type="text" name="title" required placeholder="Designing for Scale: Building Systems That Evolve With Teams" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Excerpt / Summary *</label>
          <input type="text" name="excerpt" required placeholder="Short summary of key insights..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Content (HTML or Markdown) *</label>
          <textarea name="content" rows="6" required placeholder="<p>Full article body text goes here...</p>" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Cover Image URL</label>
            <input type="url" name="cover_image_url" placeholder="https://images.unsplash.com/..." class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Tags (comma separated)</label>
            <input type="text" name="tags" placeholder="Design System, Architecture, UX" class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-200 text-sm focus:border-emerald-500 focus:outline-none" />
          </div>
        </div>

        <input type="hidden" name="published" value="true" />
        <button type="submit" class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-emerald-600 text-white font-bold text-xs shadow-md transition-colors">
          Publish Journal Article
        </button>
      </form>
    </div>

    <!-- Existing Articles List -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-card overflow-hidden">
      <div class="p-6 border-b border-slate-100">
        <h2 class="font-serif text-lg font-bold text-slate-900">Published Articles ({posts.length})</h2>
      </div>

      <div class="divide-y divide-slate-100">
        {posts.map((post) => (
          <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h3 class="font-serif font-bold text-slate-900 text-base">{post.title}</h3>
              <p class="text-xs text-slate-500 line-clamp-1">{post.excerpt}</p>
              <div class="flex items-center gap-2 mt-1.5">
                {post.tags.map((t) => (
                  <span class="text-[10px] font-semibold bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded border border-emerald-200">{t}</span>
                ))}
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <a href={`/blog/${post.slug}`} target="_blank" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold">
                Read ↗
              </a>
              <form action="http://localhost:8080/cms/blog/delete" method="POST" class="inline">
                <input type="hidden" name="id" value={post.id} />
                <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-50 text-red-600 hover:bg-red-100 text-xs font-semibold">
                  Delete
                </button>
              </form>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
