---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchProjects, fetchBlogPosts } from '../../services/api';

const projects = await fetchProjects();
const posts = await fetchBlogPosts();
---

<BaseLayout title="CMS Admin Dashboard — Elian Ross Portfolio">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Header Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 font-mono">CMS ADMIN PORTAL</span>
        <h1 class="font-serif text-3xl font-bold text-slate-900 mt-1">Portfolio Management System</h1>
      </div>
      <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="px-4 py-2 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200 text-xs font-semibold transition-colors">
          View Public Site ↗
        </a>
        <a href="http://localhost:8080/cms/logout" class="px-4 py-2 rounded-full bg-red-50 text-red-600 hover:bg-red-100 text-xs font-semibold transition-colors">
          Logout
        </a>
      </div>
    </div>

    <!-- Quick Navigation Sub-bar -->
    <div class="flex flex-wrap gap-2 mb-10">
      <a href="/cms" class="px-5 py-2 rounded-full bg-slate-900 text-white text-xs font-semibold">
        Overview
      </a>
      <a href="/cms/projects" class="px-5 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium transition-colors">
        Manage Projects ({projects.length})
      </a>
      <a href="/cms/blog" class="px-5 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium transition-colors">
        Manage Blog ({posts.length})
      </a>
      <a href="/cms/messages" class="px-5 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs font-medium transition-colors">
        Contact Messages
      </a>
    </div>

    <!-- Metrics Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-card space-y-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Total Projects</span>
        <div class="font-serif text-3xl font-bold text-slate-900">{projects.length}</div>
        <p class="text-xs text-emerald-600 font-medium">Published & Active on Portfolio</p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-card space-y-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Journal Articles</span>
        <div class="font-serif text-3xl font-bold text-slate-900">{posts.length}</div>
        <p class="text-xs text-emerald-600 font-medium">Thought Leadership Content</p>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-card space-y-2">
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Go REST API Server</span>
        <div class="font-serif text-3xl font-bold text-emerald-600">Online</div>
        <p class="text-xs text-slate-400 font-mono">http://localhost:8080/api/v1</p>
      </div>
    </div>

    <!-- Management Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Projects Module -->
      <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-serif text-xl font-bold text-slate-900">Projects Management</h2>
          <a href="/cms/projects" class="text-xs font-bold text-emerald-600 hover:underline">Manage All →</a>
        </div>
        <p class="text-slate-600 text-sm">Add, update, or remove portfolio case studies, tech stacks, and live links.</p>
        <div class="pt-2">
          <a href="/cms/projects" class="inline-block px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-emerald-600 text-white text-xs font-bold transition-colors">
            + Manage Portfolio Case Studies
          </a>
        </div>
      </div>

      <!-- Blog Module -->
      <div class="bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="font-serif text-xl font-bold text-slate-900">Blog & Journal</h2>
          <a href="/cms/blog" class="text-xs font-bold text-emerald-600 hover:underline">Manage All →</a>
        </div>
        <p class="text-slate-600 text-sm">Write design articles, manage tags, and publish thought leadership posts.</p>
        <div class="pt-2">
          <a href="/cms/blog" class="inline-block px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-emerald-600 text-white text-xs font-bold transition-colors">
            + Write New Article
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
