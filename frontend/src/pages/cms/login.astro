---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="CMS Admin Login — Elian Ross Portfolio" description="CMS Management Login Portal for Elian Ross Portfolio System.">
  <section class="max-w-md mx-auto px-6 py-20">
    <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-2xl space-y-6">
      <div class="text-center space-y-2">
        <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-slate-950 font-bold flex items-center justify-center text-lg mx-auto shadow-md">
          ER
        </div>
        <h1 class="font-serif text-2xl font-bold text-slate-900">CMS Admin Login</h1>
        <p class="text-xs text-slate-500">Authorized portfolio management portal</p>
      </div>

      <form action="http://localhost:8080/cms/login" method="POST" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Admin Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            value="admin@example.com"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:border-emerald-500 transition-all"
          />
        </div>

        <div>
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            value="admin123"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:border-emerald-500 transition-all"
          />
        </div>

        <button
          type="submit"
          class="w-full py-3.5 rounded-xl bg-slate-900 hover:bg-emerald-600 text-white font-bold text-sm shadow-md transition-all duration-300"
        >
          Sign In to CMS Dashboard
        </button>
      </form>

      <div class="text-center pt-2">
        <a href="/" class="text-xs text-slate-400 hover:text-emerald-600 transition-colors">← Back to Public Portfolio Site</a>
      </div>
    </div>
  </section>
</BaseLayout>
