---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { fetchProjects, fetchProjectBySlug } from '../../services/api';

export async function getStaticPaths() {
  const projects = await fetchProjects();
  return projects.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const projects = await fetchProjects();
const project = await fetchProjectBySlug(slug as string);

if (!project) {
  return Astro.redirect('/projects');
}

// Compute Prev and Next Projects for Navigation Controller
const currentIndex = projects.findIndex((p) => p.slug === project.slug);
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : projects[projects.length - 1];
const nextProject = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : projects[0];
---

<BaseLayout title={`${project.title} — Case Study`} description={project.short_description}>
  <article class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24 select-none">
    <!-- Reusable Breadcrumb Navigation -->
    <Breadcrumb items={[{ label: 'Projects', href: '/projects' }, { label: project.title }]} />

    <!-- Case Study Header -->
    <div class="max-w-4xl mb-12 space-y-4 gsap-reveal">
      <div class="flex flex-wrap items-center gap-3">
        {project.category && (
          <span class="px-3.5 py-1.5 rounded-full bg-governor-bay-50 dark:bg-governor-bay-950/80 text-governor-bay-600 dark:text-governor-bay-300 text-xs font-bold border border-governor-bay-200/80 dark:border-governor-bay-800/80 font-hero-sans shadow-sm">
            {project.category}
          </span>
        )}
        <span class="text-xs font-mono text-slate-400 dark:text-slate-500 font-semibold px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800">
          Published {project.year || '2025'}
        </span>
      </div>

      <h1 class="font-hero-serif italic text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        {project.title}<span class="text-governor-bay-500 not-italic">.</span>
      </h1>

      <p class="text-slate-600 dark:text-slate-300 text-lg sm:text-xl leading-relaxed font-hero-sans pt-1">
        {project.short_description}
      </p>
    </div>

    <!-- 4-Column Clean Metadata Panel -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 shadow-lg mb-12 gsap-reveal font-hero-sans">
      <div>
        <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mb-1">Client</span>
        <span class="text-slate-900 dark:text-white font-bold text-sm sm:text-base">{project.client || 'Enterprise Partner'}</span>
      </div>
      <div>
        <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mb-1">Role</span>
        <span class="text-slate-900 dark:text-white font-bold text-sm sm:text-base">{project.role || 'Lead Engineer'}</span>
      </div>
      <div>
        <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mb-1">Tech Stack</span>
        <div class="flex flex-wrap gap-1.5 mt-1">
          {project.tech_stack.slice(0, 4).map((t) => (
            <span class="text-[11px] font-medium px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/50 dark:border-slate-700/50">{t}</span>
          ))}
        </div>
      </div>
      <div>
        <span class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mb-1.5">Links & Deliverables</span>
        <div class="flex flex-wrap items-center gap-2">
          {project.live_url && (
            <a
              href={project.live_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-governor-bay-600 hover:bg-governor-bay-500 text-white font-bold text-xs shadow-sm transition-all duration-200"
            >
              <span>Live Demo</span>
              <span>↗</span>
            </a>
          )}
          {project.repo_url && (
            <a
              href={project.repo_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-bold text-xs transition-all duration-200"
            >
              <span>GitHub</span>
              <span>↗</span>
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Cover Image Hero Frame with Floating Badge -->
    <div class="relative rounded-3xl overflow-hidden shadow-xl border border-slate-200/80 dark:border-slate-800/80 mb-16 aspect-[16/9] max-h-[600px] bg-slate-100 dark:bg-slate-800 gsap-reveal">
      <img src={project.cover_image_url} alt={project.title} class="w-full h-full object-cover" />
      
      <div class="absolute bottom-4 left-4 z-10 hidden sm:flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/90 backdrop-blur-md text-xs font-bold text-white border border-slate-800 font-hero-sans shadow-lg">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Verified Metric • Production Architecture</span>
      </div>
    </div>

    <!-- Storytelling Content Sections -->
    <div class="max-w-4xl mx-auto space-y-12 text-slate-800 dark:text-slate-200 leading-relaxed text-base sm:text-lg">
      <!-- Project Overview Article Content (Clean Typography without Card Container) -->
      <div class="space-y-6 gsap-reveal max-w-3xl mx-auto">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-governor-bay-600 dark:text-governor-bay-400 font-hero-sans">
            Case Study Breakdown
          </span>
          <h2 class="font-hero-serif italic text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white">
            Project Overview<span class="text-governor-bay-500 not-italic">.</span>
          </h2>
        </div>

        <div
          class="prose dark:prose-invert max-w-none text-slate-700 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-hero-sans font-normal space-y-6 [&>p]:leading-relaxed [&>h3]:font-hero-serif [&>h3]:italic [&>h3]:text-2xl [&>h3]:font-bold [&>h3]:text-slate-900 dark:[&>h3]:text-white [&>h3]:mt-8 [&>h3]:mb-4"
          set:html={project.full_description}
        />
      </div>

      <!-- Problem & Solution Split Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 gsap-reveal">
        <div class="bg-slate-900 dark:bg-slate-950 text-white p-8 sm:p-10 rounded-3xl border border-slate-800 shadow-xl space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-rose-400 font-hero-sans">The Problem</span>
          <h3 class="font-hero-serif italic text-xl sm:text-2xl font-bold">Cognitive Overload & System Fragmentation</h3>
          <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-hero-sans">
            Legacy tools suffered from inconsistent components, high latency in decision workflows, and lack of dynamic design token synchronization across platforms.
          </p>
        </div>

        <div class="bg-governor-bay-50 dark:bg-governor-bay-950/80 text-slate-900 dark:text-white p-8 sm:p-10 rounded-3xl border border-governor-bay-200/80 dark:border-governor-bay-800/80 shadow-xl space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-governor-bay-600 dark:text-governor-bay-400 font-hero-sans">The Solution</span>
          <h3 class="font-hero-serif italic text-xl sm:text-2xl font-bold">Unified Token System & Motion Engine</h3>
          <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed font-hero-sans">
            Engineered a modular design token architecture paired with fluid GSAP micro-interactions, resulting in a 40% boost in user conversion speed.
          </p>
        </div>
      </div>
    </div>

    <!-- Prev / Next Project Navigation Controller -->
    <div class="mt-20 pt-12 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-6 font-hero-sans gsap-reveal">
      {prevProject && (
        <a
          href={`/projects/${prevProject.slug}`}
          class="group p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between"
        >
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2 block group-hover:text-governor-bay-600 transition-colors">
            ← Previous Case Study
          </span>
          <span class="font-hero-serif italic text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-governor-bay-600 dark:group-hover:text-governor-bay-400 transition-colors">
            {prevProject.title}
          </span>
        </a>
      )}

      {nextProject && (
        <a
          href={`/projects/${nextProject.slug}`}
          class="group p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col justify-between text-right sm:col-start-2"
        >
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2 block group-hover:text-governor-bay-600 transition-colors">
            Next Case Study →
          </span>
          <span class="font-hero-serif italic text-lg sm:text-xl font-bold text-slate-900 dark:text-white group-hover:text-governor-bay-600 dark:group-hover:text-governor-bay-400 transition-colors">
            {nextProject.title}
          </span>
        </a>
      )}
    </div>
  </article>
</BaseLayout>

<script>
  import { initScrollReveals } from '../../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    initScrollReveals();
  });

  document.addEventListener('astro:page-load', () => {
    initScrollReveals();
  });
</script>
