---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchProjects, fetchProjectBySlug } from '../../services/api';

export async function getStaticPaths() {
  const projects = await fetchProjects();
  return projects.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const project = await fetchProjectBySlug(slug as string);

if (!project) {
  return Astro.redirect('/work');
}
---

<BaseLayout title={`${project.title} — Case Study by Elian Ross`} description={project.short_description}>
  <article class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Back Button -->
    <a href="/work" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-emerald-600 mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>Back to Selected Work</span>
    </a>

    <!-- Case Study Header -->
    <div class="max-w-3xl mb-12 space-y-4 gsap-reveal">
      <div class="flex flex-wrap items-center gap-3">
        {project.category && (
          <span class="px-3.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold border border-emerald-200">
            {project.category}
          </span>
        )}
        <span class="text-xs font-mono text-slate-400">Published {project.year || '2024'}</span>
      </div>

      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
        {project.title}
      </h1>

      <p class="text-slate-600 text-lg sm:text-xl leading-relaxed">
        {project.short_description}
      </p>
    </div>

    <!-- Metadata Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 p-6 sm:p-8 rounded-3xl glass-panel shadow-glass border border-slate-200/80 mb-12 gsap-reveal">
      <div>
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Client</span>
        <span class="text-slate-900 font-bold text-sm sm:text-base">{project.client || 'Enterprise Partner'}</span>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Role</span>
        <span class="text-slate-900 font-bold text-sm sm:text-base">{project.role || 'Lead Product Designer'}</span>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Tech & Tools</span>
        <div class="flex flex-wrap gap-1 mt-1">
          {project.tech_stack.slice(0, 3).map((t) => (
            <span class="text-[11px] font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-700">{t}</span>
          ))}
        </div>
      </div>
      <div>
        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Deliverable</span>
        {project.live_url ? (
          <a href={project.live_url} target="_blank" rel="noopener noreferrer" class="text-emerald-600 font-bold text-sm hover:underline inline-flex items-center gap-1">
            <span>Live Prototype ↗</span>
          </a>
        ) : (
          <span class="text-slate-700 font-bold text-sm">Full Production Spec</span>
        )}
      </div>
    </div>

    <!-- Cover Image Hero -->
    <div class="rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80 mb-16 aspect-[16/9] max-h-[600px] gsap-reveal">
      <img src={project.cover_image_url} alt={project.title} class="w-full h-full object-cover" />
    </div>

    <!-- Content Sections -->
    <div class="max-w-3xl mx-auto space-y-12 text-slate-800 leading-relaxed text-base sm:text-lg">
      <!-- Overview Card -->
      <div class="bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-card space-y-4">
        <h2 class="font-serif text-2xl font-bold text-slate-900">Project Overview</h2>
        <div class="text-slate-600 space-y-4 font-normal" set:html={project.full_description} />
      </div>

      <!-- Problem & Solution Split -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-slate-900 text-white p-8 rounded-3xl space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">The Problem</span>
          <h3 class="font-serif text-xl font-bold">Cognitive Overload & System Fragmentation</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Existing tools suffered from inconsistent components, high latency in decision workflows, and lack of design token synchronization.
          </p>
        </div>

        <div class="bg-emerald-500 text-slate-950 p-8 rounded-3xl space-y-3">
          <span class="text-xs font-bold uppercase tracking-widest text-slate-950 font-mono">The Solution</span>
          <h3 class="font-serif text-xl font-bold">Unified Token Architecture & GSAP Motion</h3>
          <p class="text-slate-900 text-sm leading-relaxed font-medium">
            Engineered a modular design system paired with interactive motion prototypes, resulting in a 40% reduction in task completion time.
          </p>
        </div>
      </div>
    </div>

    <!-- Footer Call to Action -->
    <div class="mt-20 pt-12 border-t border-slate-200 flex items-center justify-between">
      <a href="/work" class="text-slate-900 font-semibold hover:text-emerald-600 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>All Case Studies</span>
      </a>

      <a href="/contact" class="px-6 py-3 rounded-full bg-slate-900 hover:bg-emerald-600 text-white text-sm font-semibold transition-colors">
        Discuss Similar Project
      </a>
    </div>
  </article>
</BaseLayout>
