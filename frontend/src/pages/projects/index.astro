---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { fetchProjects } from '../../services/api';

const projects = await fetchProjects();
---

<BaseLayout title="Selected Projects & Case Studies — Fadhil Abdul Fattah" description="Complete catalog of enterprise case studies, web applications, and system architecture projects.">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24 select-none">
    <!-- Reusable Breadcrumb Navigation -->
    <Breadcrumb items={[{ label: 'Projects & Case Studies' }]} />

    <!-- Header Section -->
    <div class="max-w-3xl mb-12 space-y-3 gsap-reveal">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-governor-bay-500 animate-pulse"></span>
        <span class="text-xs font-bold uppercase tracking-widest text-governor-bay-600 dark:text-governor-bay-400 font-hero-sans">
          Portfolio Archive
        </span>
      </div>
      <h1 class="font-hero-serif italic text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        Selected Case Studies & Projects<span class="text-governor-bay-500 not-italic">.</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed font-hero-sans pt-1">
        Deep dives into multi-platform digital products, scalable token architectures, and high-performance engineering.
      </p>
    </div>

    <!-- Projects Grid (Clean Minimalist Bento Style) -->
    {projects.length === 0 ? (
      <div class="p-12 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800/80 text-center font-hero-sans">
        <p class="text-slate-900 dark:text-white font-bold text-lg mb-2">No Published Projects Found</p>
        <p class="text-slate-500 text-sm">Add projects via the CMS admin portal.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10 gsap-stagger-parent">
        {projects.map((project) => (
          <article class="gsap-stagger-child project-card-tilt group bg-white dark:bg-slate-900 text-slate-900 dark:text-white rounded-3xl border border-slate-200/80 dark:border-slate-800/80 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between">
            <!-- Image Frame -->
            <a href={`/projects/${project.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800/80">
              <img
                src={project.cover_image_url}
                alt={project.title}
                class="project-tilt-target w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
              />
              {project.category && (
                <span class="absolute top-4 left-4 px-3.5 py-1.5 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur-md text-xs font-bold text-slate-800 dark:text-slate-200 border border-slate-200/60 dark:border-slate-800 font-hero-sans shadow-sm">
                  {project.category}
                </span>
              )}
            </a>

            <!-- Details -->
            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800/80 pb-3 text-xs font-semibold">
                  <span class="text-governor-bay-600 dark:text-governor-bay-400 uppercase tracking-wider font-hero-sans">
                    {project.client || 'Featured Case Study'}
                  </span>
                  {project.year && <span class="font-mono text-slate-500 dark:text-slate-400 font-medium px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800">{project.year}</span>}
                </div>

                <h2 class="font-hero-serif italic text-2xl font-bold text-slate-900 dark:text-white group-hover:text-governor-bay-600 dark:group-hover:text-governor-bay-400 transition-colors">
                  <a href={`/projects/${project.slug}`}>{project.title}</a>
                </h2>

                <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed font-hero-sans line-clamp-3">
                  {project.short_description}
                </p>
              </div>

              <!-- Footer: Tech Stack & CTA -->
              <div class="pt-4 border-t border-slate-100 dark:border-slate-800 space-y-4">
                <div class="flex flex-wrap gap-1.5">
                  {project.tech_stack.slice(0, 4).map((tech) => (
                    <span class="text-[11px] font-medium px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-hero-sans border border-slate-200/60 dark:border-slate-700/60">
                      {tech}
                    </span>
                  ))}
                </div>

                <a
                  href={`/projects/${project.slug}`}
                  class="project-cta-btn inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-900 dark:text-white hover:text-governor-bay-600 dark:hover:text-governor-bay-400 transition-colors font-hero-sans"
                >
                  <span>Read Case Study</span>
                  <span class="project-cta-arrow inline-block">→</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<script>
  import { initScrollReveals } from '../../utils/gsap';
  document.addEventListener('DOMContentLoaded', () => {
    initScrollReveals();
  });
  document.addEventListener('astro:page-load', () => {
    initScrollReveals();
  });
</script>
