---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchProjects } from '../../services/api';

const projects = await fetchProjects();
---

<BaseLayout title="Proyek & Studi Kasus — Ftthreign" description="Katalog lengkap proyek perangkat lunak, aplikasi web, dan studi kasus sistem backend.">
  <section class="max-w-container mx-auto px-4 sm:px-6 md:px-margin-page pt-12 sm:pt-16 pb-8 sm:pb-12">
    <div class="gsap-reveal">
      <span class="inline-block text-[11px] sm:text-xs font-mono uppercase tracking-widest text-ink bg-acid border border-black dark:text-dark-paper dark:bg-dark-acid dark:border-dark-border px-2.5 sm:px-3 py-1 mb-4">
        03 // PORTFOLIO & WORK
      </span>
      <h1 class="font-mono text-2xl sm:text-3xl md:text-5xl font-bold tracking-tight text-acid dark:text-dark-acid mb-4">
        Semua Proyek
      </h1>
      <p class="text-xs sm:text-sm md:text-base font-mono text-muted dark:text-dark-muted max-w-xl leading-relaxed">
        Eksplorasi aplikasi web, sistem backend, dan proyek open-source yang dibangun dengan fokus pada arsitektur dan performa.
      </p>
    </div>
  </section>

  <div class="max-w-container mx-auto px-4 sm:px-6 md:px-margin-page mb-6 sm:mb-8">
    <hr class="border-black dark:border-dark-border" />
  </div>

  <section class="max-w-container mx-auto px-4 sm:px-6 md:px-margin-page pb-16 sm:pb-24">
    {projects.length === 0 ? (
      <div class="p-6 sm:p-12 border border-black dark:border-dark-border bg-paper-neutral dark:bg-dark-paper-neutral text-center">
        <p class="font-mono text-sm sm:text-base text-ink dark:text-dark-ink mb-2">[ Belum Ada Proyek yang Dipublikasikan ]</p>
        <p class="text-xs font-mono text-muted dark:text-dark-muted">Tambahkan proyek baru melalui CMS Admin Panel.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {projects.map((p) => (
          <article class="gsap-reveal group border border-black dark:border-dark-border bg-paper dark:bg-dark-paper-neutral overflow-hidden hover:border-black dark:hover:border-dark-acid transition-all">
            <a href={`/projects/${p.slug}`} class="block">
              <div class="aspect-video bg-paper-subtle dark:bg-dark-paper-subtle border-b border-black dark:border-dark-border flex items-center justify-center overflow-hidden">
                {p.cover_image_url ? (
                  <img src={p.cover_image_url} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                ) : (
                  <span class="font-mono text-xs uppercase tracking-widest text-muted dark:text-dark-muted">[ No Preview Image ]</span>
                )}
              </div>
              <div class="p-6">
                <h2 class="font-mono text-lg font-bold text-ink dark:text-dark-ink group-hover:text-acid dark:group-hover:text-dark-acid transition-colors">
                  {p.title}
                </h2>
                <p class="text-xs font-mono text-muted dark:text-dark-muted mt-2 leading-relaxed line-clamp-2">
                  {p.short_description}
                </p>
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {p.tech_stack?.map((tech) => (
                    <span class="text-[11px] font-mono bg-paper-neutral dark:bg-dark-paper-subtle border border-black dark:border-dark-border text-ink dark:text-dark-ink px-2 py-0.5">
                      {tech}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>

  <script>
    import { gsap, ScrollTrigger } from '../../utils/gsap';
    document.addEventListener('DOMContentLoaded', () => {
      // Page header stagger
      gsap.fromTo(
        'header',
        { y: -64, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.55, ease: 'power3.out' }
      );

      const headerEl = document.querySelector('h1');
      const badge = document.querySelector('span.inline-block');
      const desc = document.querySelector('p.text-xs');

      if (badge) gsap.fromTo(badge, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.45, ease: 'power2.out', delay: 0.3 });
      if (headerEl) gsap.fromTo(headerEl, { opacity: 0, y: 24 }, { opacity: 1, y: 0, duration: 0.6, ease: 'power3.out', delay: 0.4 });
      if (desc) gsap.fromTo(desc, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', delay: 0.55 });

      // Divider wipe
      document.querySelectorAll('hr').forEach((hr) => {
        gsap.fromTo(hr, { scaleX: 0, transformOrigin: 'left center' }, {
          scaleX: 1, duration: 0.7, ease: 'power2.out',
          scrollTrigger: { trigger: hr, start: 'top 95%', toggleActions: 'play none none none' },
        });
      });

      // Project cards stagger slide up
      const cards = document.querySelectorAll('article');
      if (cards.length > 0) {
        gsap.fromTo(
          cards,
          { opacity: 0, y: 50 },
          {
            opacity: 1,
            y: 0,
            duration: 0.65,
            ease: 'power3.out',
            stagger: 0.13,
            scrollTrigger: { trigger: cards[0], start: 'top 85%', toggleActions: 'play none none none' },
          }
        );
      }
    });
  </script>
</BaseLayout>

