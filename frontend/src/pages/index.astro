---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TechStackMarquee from '../components/TechStackMarquee.astro';
import ProcessSection from '../components/ProcessSection.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import ServicesTeaser from '../components/ServicesTeaser.astro';
import LatestBlog from '../components/LatestBlog.astro';
import SkillsSection from '../components/SkillsSection.astro';
import { fetchProjects, fetchProfile, fetchBlogPosts } from '../services/api';

const profile = await fetchProfile();
const projects = await fetchProjects();
const blogPosts = await fetchBlogPosts();
const featuredProjects = projects.slice(0, 4);
const latestBlogPosts = blogPosts.slice(0, 3);
---

<BaseLayout title={`${profile.name} — Product Designer & Fullstack Engineer`} description={profile.bio}>
  <Hero name={profile.name} tagline={profile.tagline} />
  <TechStackMarquee />
  <ProcessSection />
  <SkillsSection />
  <FeaturedProjects projects={featuredProjects} />
  <LatestBlog posts={latestBlogPosts} />
  <ServicesTeaser />
</BaseLayout>
