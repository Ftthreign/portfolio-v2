---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProfile, fetchSkills, fetchProjects } from '../services/api';

const profile = await fetchProfile();
const skills = await fetchSkills();
const projects = await fetchProjects();
---

<BaseLayout title={`${profile.name} — ${profile.tagline}`}>
  <!-- Hero Section -->
  <section class="max-w-container mx-auto px-margin-mobile md:px-gutter pt-16 md:pt-28 pb-16">
    <div class="hero-content opacity-0 translate-y-6">
      <span class="inline-block text-xs font-semibold uppercase tracking-widest text-terracotta bg-terracotta/10 px-3 py-1 rounded mb-6">
        Fullstack Software Engineer
      </span>
      <h1 class="font-serif text-4xl md:text-6xl font-bold leading-tight tracking-tight text-charcoal mb-6">
        {profile.name}
      </h1>
      <p class="text-xl md:text-2xl font-serif text-charcoal-variant max-w-2xl leading-relaxed mb-8">
        {profile.tagline}
      </p>
      <p class="text-base md:text-lg text-charcoal-variant max-w-xl leading-relaxed mb-10">
        {profile.bio}
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="#projects"
          class="bg-charcoal text-cream font-medium px-6 py-3 rounded text-sm hover:bg-terracotta transition-colors duration-200"
        >
          Lihat Proyek
        </a>
        <a
          href="#contact"
          class="border border-charcoal/20 text-charcoal font-medium px-6 py-3 rounded text-sm hover:border-charcoal transition-colors duration-200"
        >
          Hubungi Saya
        </a>
      </div>
    </div>
  </section>

  <!-- Section Divider -->
  <div class="max-w-container mx-auto px-margin-mobile md:px-gutter">
    <hr class="border-charcoal/10 my-12" />
  </div>

  <!-- About / Intentionality Section -->
  <section id="about" class="gsap-reveal max-w-container mx-auto px-margin-mobile md:px-gutter py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
      <div class="md:col-span-4">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold tracking-tight text-charcoal">
          Filosofi & Pendekatan
        </h2>
      </div>
      <div class="md:col-span-8 space-y-4 text-base text-charcoal-variant leading-relaxed">
        <p>
          Saya berfokus pada pembangunan perangkat lunak berarsitektur bersih, performan tinggi, dan mudah dirawat. Kombinasi <strong>Go</strong> di sisi backend dan <strong>TypeScript / Astro</strong> di sisi frontend memberikan keseimbangan sempurna antara efisiensi eksekusi dan pengalaman pengguna yang responsif.
        </p>
        <p>
          Setiap baris kode ditulis dengan intensionalitas — menghindari kerumitan berlebih dan mengutamakan kejelasan (clarity), performa, serta keandalan jangka panjang.
        </p>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="gsap-reveal max-w-container mx-auto px-margin-mobile md:px-gutter py-16">
    <h2 class="font-serif text-2xl md:text-3xl font-semibold tracking-tight text-charcoal mb-8">
      Keahlian & Teknologi
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 rounded-lg bg-cream-highest/40 border border-charcoal/10 space-y-3">
        <h3 class="font-serif font-semibold text-lg text-charcoal">Backend Systems</h3>
        <p class="text-xs text-charcoal-variant">High-performance APIs & microservices</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Go (Golang)</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">PostgreSQL</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">REST API</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">HTMX</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Docker</span>
        </div>
      </div>

      <div class="p-6 rounded-lg bg-cream-highest/40 border border-charcoal/10 space-y-3">
        <h3 class="font-serif font-semibold text-lg text-charcoal">Frontend Engineering</h3>
        <p class="text-xs text-charcoal-variant">Modern, accessible, fast interfaces</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">TypeScript</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Astro TS</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">TailwindCSS</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">GSAP</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Bun</span>
        </div>
      </div>

      <div class="p-6 rounded-lg bg-cream-highest/40 border border-charcoal/10 space-y-3">
        <h3 class="font-serif font-semibold text-lg text-charcoal">Infrastructure & Cloud</h3>
        <p class="text-xs text-charcoal-variant">Self-hosted, reliable deployment</p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Linux / VPS</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Cloudflare R2</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Caddy Server</span>
          <span class="text-xs font-mono bg-sage/10 text-sage-dark px-2.5 py-1 rounded">Docker Compose</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Showcase Section -->
  <section id="projects" class="gsap-reveal max-w-container mx-auto px-margin-mobile md:px-gutter py-16">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-4">
      <div>
        <h2 class="font-serif text-2xl md:text-3xl font-semibold tracking-tight text-charcoal">
          Proyek Terpilih
        </h2>
        <p class="text-sm text-charcoal-variant mt-1">Studi kasus dan aplikasi yang dibangun dengan kehati-hatian.</p>
      </div>
    </div>

    {projects.length === 0 ? (
      <div class="p-8 rounded-lg border border-charcoal/10 bg-cream-container/30 text-center">
        <p class="font-serif text-base text-charcoal-variant">Belum ada proyek yang ditampilkan.</p>
        <p class="text-xs text-charcoal-variant/70 mt-1">Gunakan CMS Admin Panel untuk menambah proyek baru.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projects.map((p) => (
          <article class="group rounded-lg border border-charcoal/10 bg-cream-highest/20 overflow-hidden hover:border-charcoal/30 transition-all duration-300">
            <div class="aspect-video bg-cream-container flex items-center justify-center overflow-hidden">
              {p.cover_image_url ? (
                <img src={p.cover_image_url} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <span class="font-serif text-charcoal-variant/40 text-sm">No Preview Image</span>
              )}
            </div>
            <div class="p-6">
              <h3 class="font-serif text-xl font-semibold text-charcoal group-hover:text-terracotta transition-colors">
                {p.title}
              </h3>
              <p class="text-sm text-charcoal-variant mt-2 leading-relaxed line-clamp-2">
                {p.short_description}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-4">
                {p.tech_stack?.map((tech) => (
                  <span class="text-[11px] font-mono bg-sage/10 text-sage-dark px-2 py-0.5 rounded">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>

  <!-- Contact Section -->
  <section id="contact" class="gsap-reveal max-w-container mx-auto px-margin-mobile md:px-gutter py-16">
    <div class="rounded-lg border border-charcoal/10 bg-cream-container/40 p-8 md:p-12">
      <div class="max-w-xl">
        <h2 class="font-serif text-2xl md:text-3xl font-semibold text-charcoal mb-4">
          Mari Berdiskusi & Bekerjasama
        </h2>
        <p class="text-sm text-charcoal-variant leading-relaxed mb-6">
          Tertarik untuk mendiskusikan proyek, kolaborasi, atau sekadar bertukar ide teknis? Kirimkan pesan di bawah ini.
        </p>

        <form id="contactForm" class="space-y-4">
          <div>
            <label class="block text-xs uppercase font-semibold tracking-wider text-charcoal mb-1">Nama</label>
            <input type="text" name="name" required class="w-full bg-cream border-b-2 border-charcoal/20 focus:border-terracotta outline-none py-2 px-1 text-sm text-charcoal transition-colors" />
          </div>
          <div>
            <label class="block text-xs uppercase font-semibold tracking-wider text-charcoal mb-1">Email</label>
            <input type="email" name="email" required class="w-full bg-cream border-b-2 border-charcoal/20 focus:border-terracotta outline-none py-2 px-1 text-sm text-charcoal transition-colors" />
          </div>
          <div>
            <label class="block text-xs uppercase font-semibold tracking-wider text-charcoal mb-1">Pesan</label>
            <textarea name="message" rows="4" required class="w-full bg-cream border-b-2 border-charcoal/20 focus:border-terracotta outline-none py-2 px-1 text-sm text-charcoal transition-colors resize-none"></textarea>
          </div>
          <button
            type="submit"
            class="bg-charcoal text-cream text-xs uppercase tracking-wider font-semibold px-6 py-3 rounded hover:bg-terracotta transition-colors duration-200"
          >
            Kirim Pesan
          </button>
          <div id="contactAlert" class="hidden text-xs font-semibold p-3 rounded"></div>
        </form>
      </div>
    </div>
  </section>

  <!-- GSAP Animation Script -->
  <script>
    import { gsap, ScrollTrigger } from '../utils/gsap';

    document.addEventListener('DOMContentLoaded', () => {
      // Hero Entrance Animation
      gsap.to('.hero-content', {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: 'power2.out',
        delay: 0.1,
      });

      // Scroll Reveal Animations
      const revealElements = document.querySelectorAll('.gsap-reveal');
      revealElements.forEach((el) => {
        gsap.fromTo(
          el,
          { opacity: 0, y: 30 },
          {
            opacity: 1,
            y: 0,
            duration: 0.8,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 85%',
              toggleActions: 'play none none none',
            },
          }
        );
      });

      // Contact Form Submission Script
      const form = document.getElementById('contactForm') as HTMLFormElement;
      const alert = document.getElementById('contactAlert');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const body = {
          name: formData.get('name'),
          email: formData.get('email'),
          message: formData.get('message'),
        };

        try {
          const res = await fetch('/api/v1/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body),
          });
          if (res.ok && alert) {
            alert.textContent = 'Pesan Anda berhasil terkirim!';
            alert.className = 'text-xs font-semibold p-3 rounded bg-sage/20 text-sage-dark block';
            form.reset();
          }
        } catch {
          if (alert) {
            alert.textContent = 'Gagal mengirim pesan. Silakan coba lagi.';
            alert.className = 'text-xs font-semibold p-3 rounded bg-red-100 text-red-700 block';
          }
        }
      });
    });
  </script>
</BaseLayout>
