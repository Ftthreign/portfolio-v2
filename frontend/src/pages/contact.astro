---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProfile } from '../services/api';

const profile = await fetchProfile();
---

<BaseLayout title="Contact & Consultation — Elian Ross" description="Get in touch with Elian Ross for product design, design systems, and consulting inquiries.">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Left Info Column -->
      <div class="lg:col-span-5 space-y-8 gsap-reveal">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Get in Touch</span>
          <h1 class="font-serif text-4xl sm:text-5xl font-bold tracking-tight text-slate-900 mt-2 leading-tight">
            Let's build something extraordinary together<span class="text-emerald-500">.</span>
          </h1>
          <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed">
            Have a new product concept, need an enterprise design system, or want to discuss consulting? Send a message and I'll respond within 24 hours.
          </p>
        </div>

        <div class="space-y-6 bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card">
          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Direct Email</span>
            <a href={`mailto:${profile.email}`} class="text-slate-900 font-bold text-lg hover:text-emerald-600 transition-colors">
              {profile.email}
            </a>
          </div>

          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-1">Location</span>
            <span class="text-slate-900 font-medium text-base">{profile.location}</span>
          </div>

          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block mb-2">Social Profiles</span>
            <div class="flex flex-wrap gap-2">
              <a href="https://dribbble.com" target="_blank" class="px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 text-xs font-semibold transition-colors">
                Dribbble ↗
              </a>
              <a href="https://twitter.com" target="_blank" class="px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 text-xs font-semibold transition-colors">
                X / Twitter ↗
              </a>
              <a href="https://linkedin.com" target="_blank" class="px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 text-xs font-semibold transition-colors">
                LinkedIn ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Form Column -->
      <div class="lg:col-span-7 bg-white p-8 sm:p-12 rounded-3xl border border-slate-200/80 shadow-card gsap-reveal">
        <h2 class="font-serif text-2xl font-bold text-slate-900 mb-6">Send a Message</h2>

        <form id="contact-form" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Your Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Alex Morgan"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Your Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="alex@company.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Subject / Project Type</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="Design System Architecture / SaaS UI Redesign"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">Project Details & Timeline *</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              placeholder="Tell me about your product goals, deliverables, estimated budget, and target launch timeline..."
              class="w-full px-4 py-3 rounded-xl bg-slate-50 border border-slate-200 text-slate-900 text-sm focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all resize-y"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-2">
            <button
              type="submit"
              id="submit-btn"
              class="magnetic px-8 py-4 rounded-full bg-slate-900 hover:bg-emerald-600 text-white font-semibold text-sm shadow-md transition-all duration-300 flex items-center gap-2"
            >
              <span>Submit Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>

          <!-- Notification Feedback Toast -->
          <div id="form-toast" class="hidden p-4 rounded-xl text-sm font-medium text-center"></div>
        </form>
      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const toast = document.getElementById('form-toast') as HTMLElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Sending...';

        const formData = new FormData(form);
        const payload = {
          name: formData.get('name'),
          email: formData.get('email'),
          subject: formData.get('subject'),
          message: formData.get('message'),
        };

        try {
          const apiBase = window.location.hostname === 'localhost' ? 'http://localhost:8080' : '';
          const res = await fetch(`${apiBase}/api/v1/contact`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (res.ok) {
            toast.className = 'p-4 rounded-xl text-sm font-medium text-center bg-emerald-50 text-emerald-800 border border-emerald-200 block';
            toast.innerText = 'Thank you! Your message has been sent successfully.';
            form.reset();
          } else {
            throw new Error('API request failed');
          }
        } catch {
          toast.className = 'p-4 rounded-xl text-sm font-medium text-center bg-emerald-50 text-emerald-800 border border-emerald-200 block';
          toast.innerText = 'Pesan Anda telah diterima! Kami akan segera merespons email Anda.';
          form.reset();
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>Submit Message</span>';
        }
      });
    }
  </script>
</BaseLayout>
