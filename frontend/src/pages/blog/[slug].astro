---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchBlogPosts, fetchBlogPostBySlug } from '../../services/api';

export async function getStaticPaths() {
  const posts = await fetchBlogPosts();
  return posts.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;
const post = await fetchBlogPostBySlug(slug as string);

if (!post) {
  return Astro.redirect('/blog');
}
---

<BaseLayout title={`${post.title} — Elian Ross`} description={post.excerpt}>
  <article class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Back Link -->
    <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-slate-500 hover:text-emerald-600 mb-8 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span>Back to Journal</span>
    </a>

    <!-- Header -->
    <header class="max-w-3xl mx-auto space-y-4 mb-12 gsap-reveal">
      <div class="flex items-center gap-3">
        <div class="flex flex-wrap gap-1.5">
          {post.tags.map((tag) => (
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
              {tag}
            </span>
          ))}
        </div>
        <span class="text-xs text-slate-400 font-mono">• {post.reading_time_minutes} min read</span>
      </div>

      <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-slate-900 leading-tight">
        {post.title}
      </h1>

      <p class="text-slate-600 text-lg leading-relaxed">
        {post.excerpt}
      </p>
    </header>

    <!-- Cover Image -->
    {post.cover_image_url && (
      <div class="max-w-4xl mx-auto rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80 mb-16 aspect-[16/9] max-h-[550px] gsap-reveal">
        <img src={post.cover_image_url} alt={post.title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Article Content -->
    <div class="max-w-3xl mx-auto bg-white p-8 sm:p-14 rounded-3xl border border-slate-200/80 shadow-card text-slate-800 space-y-6 leading-relaxed prose prose-slate text-base sm:text-lg font-normal" set:html={post.content} />

    <!-- Article Footer -->
    <div class="max-w-3xl mx-auto mt-16 pt-8 border-t border-slate-200 flex items-center justify-between">
      <a href="/blog" class="text-slate-900 font-semibold hover:text-emerald-600 flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>All Articles</span>
      </a>

      <a href="/contact" class="px-6 py-3 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition-colors">
        Discuss Ideas
      </a>
    </div>
  </article>
</BaseLayout>
