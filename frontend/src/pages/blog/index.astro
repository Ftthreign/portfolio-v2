---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchBlogPosts } from '../../services/api';

const posts = await fetchBlogPosts();
---

<BaseLayout title="Writing & Thought Leadership — Elian Ross" description="Articles on product design, design systems, motion UI, and software architecture by Elian Ross.">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Header -->
    <div class="max-w-2xl mb-12 gsap-reveal">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Journal & Insights</span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mt-2">
        Writing & Thoughts<span class="text-emerald-500">.</span>
      </h1>
      <p class="text-slate-600 text-lg mt-4 leading-relaxed">
        Perspectives on building resilient design systems, motion physics, and design leadership in modern tech organisations.
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="space-y-8 max-w-4xl gsap-stagger-parent">
      {posts.map((post) => (
        <article class="gsap-stagger-child bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-card hover:shadow-hover hover:-translate-y-1 transition-all duration-300 flex flex-col md:flex-row gap-8 group">
          <!-- Cover Thumbnail -->
          {post.cover_image_url && (
            <a href={`/blog/${post.slug}`} class="md:w-1/3 aspect-[16/10] rounded-2xl overflow-hidden bg-slate-100 shrink-0">
              <img src={post.cover_image_url} alt={post.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </a>
          )}

          <!-- Post Content -->
          <div class="flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="flex flex-wrap gap-1.5">
                  {post.tags.map((tag) => (
                    <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                      {tag}
                    </span>
                  ))}
                </div>
                <span class="text-xs text-slate-400 font-mono">• {post.reading_time_minutes} min read</span>
              </div>

              <h2 class="font-serif text-2xl font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">
                <a href={`/blog/${post.slug}`}>{post.title}</a>
              </h2>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {post.excerpt}
              </p>
            </div>

            <div class="pt-2">
              <a href={`/blog/${post.slug}`} class="text-xs font-bold text-slate-900 group-hover:text-emerald-600 inline-flex items-center gap-1 transition-colors">
                <span>Read Full Article</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
