---
import BaseLayout from '../layouts/BaseLayout.astro';

const services = [
  {
    num: '01',
    title: 'Product UI/UX Design',
    subtitle: 'End-to-end user experience & visual interface design for web & mobile applications.',
    description: 'Transforming complex product specs into intuitive, high-converting digital interfaces backed by user research and iterative prototyping.',
    deliverables: [
      'User Flow & Information Architecture',
      'Wireframes & Interactive Prototypes',
      'High-Fidelity UI Screens (Figma)',
      'Responsive Mobile & Desktop Layouts',
      'Design Handoff & Developer Specs',
    ],
  },
  {
    num: '02',
    title: 'Enterprise Design Systems',
    subtitle: 'Scalable design token foundations and modular component libraries.',
    description: 'Creating resilient, tokenized design systems that unify multi-platform applications and accelerate engineering squad velocity.',
    deliverables: [
      'Design Token Architecture (Color, Typography, Spatial)',
      'Figma Component Library (Variants, Auto Layout)',
      'WCAG 2.1 AA Accessibility Standards',
      'React & Tailwind CSS Token Sync',
      'Component Documentation & Usage Specs',
    ],
  },
  {
    num: '03',
    title: 'Motion UI & Interactive Prototypes',
    subtitle: 'GSAP scroll-triggered reveals, micro-interactions, and visual delight.',
    description: 'Elevating digital products with intentional motion physics that guide user attention, provide instant feedback, and reduce cognitive friction.',
    deliverables: [
      'GSAP & ScrollTrigger Animations',
      'Micro-Interactions & Hover Physics',
      'Interactive Onboarding Journeys',
      'Page Transitions & Dynamic Loader UI',
      'Lottie & SVG Animation Assets',
    ],
  },
  {
    num: '04',
    title: 'Web Development & Architecture',
    subtitle: 'High-performance static site generation and modern frontend engineering.',
    description: 'Building ultra-fast, SEO-optimized web applications with Astro, Tailwind CSS, TypeScript, and Go REST APIs.',
    deliverables: [
      'Astro 5 SSG / SSR Architecture',
      'Tailwind CSS Styling System',
      'Clean TypeScript Component Structure',
      'REST API Integration (Go Backend)',
      'Lighthouse 95+ Performance Tuning',
    ],
  },
];
---

<BaseLayout title="Services & Engagement Options — Elian Ross" description="Design capabilities, design system architecture, motion UI, and engagement models offered by Elian Ross.">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Header -->
    <div class="max-w-3xl mb-16 gsap-reveal">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Capabilities</span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mt-2">
        Design & Engineering Offerings<span class="text-emerald-500">.</span>
      </h1>
      <p class="text-slate-600 text-lg mt-4 leading-relaxed">
        From early-stage product concepting to enterprise design token architecture, I offer specialized services to help product teams build memorable software.
      </p>
    </div>

    <!-- Services Detailed Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24 gsap-stagger-parent">
      {services.map((service) => (
        <div class="gsap-stagger-child bg-white p-8 sm:p-10 rounded-3xl border border-slate-200/80 shadow-card flex flex-col justify-between space-y-6 hover:shadow-hover hover:-translate-y-1 transition-all duration-300">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 font-serif font-bold flex items-center justify-center border border-emerald-200">
                {service.num}
              </span>
              <span class="text-xs font-semibold text-emerald-600 uppercase tracking-widest">Service Spec</span>
            </div>

            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900">
              {service.title}
            </h2>

            <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
              {service.description}
            </p>

            <div class="pt-4 space-y-2 border-t border-slate-100">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Key Deliverables</span>
              <ul class="space-y-2">
                {service.deliverables.map((item) => (
                  <li class="flex items-center gap-2 text-xs sm:text-sm text-slate-700 font-medium">
                    <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 text-xs font-bold text-slate-900 hover:text-emerald-600 transition-colors"
            >
              <span>Book {service.title}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Engagement Models Section -->
    <div class="bg-slate-900 text-white rounded-[2.5rem] p-8 sm:p-14 shadow-2xl relative overflow-hidden">
      <div class="max-w-xl mb-12 relative z-10">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400">Collaboration</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-white mt-2">
          Flexible Engagement Models<span class="text-emerald-400">.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
        <!-- Model 1 -->
        <div class="bg-slate-800/80 p-8 rounded-3xl border border-slate-700 space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 font-mono">Option 01</span>
          <h3 class="font-serif text-xl font-bold text-white">Project-Based Sprint</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Fixed scope product design or design system build delivered over 4 to 8 week dedicated sprints.
          </p>
          <span class="inline-block text-xs font-semibold text-emerald-300 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-800">Best for New Product Launches</span>
        </div>

        <!-- Model 2 -->
        <div class="bg-slate-800/80 p-8 rounded-3xl border border-slate-700 space-y-4 border-emerald-500/50">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 font-mono">Option 02</span>
          <h3 class="font-serif text-xl font-bold text-white">Monthly Retainer</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Dedicated design leadership & design system maintenance embedded directly into your product team.
          </p>
          <span class="inline-block text-xs font-semibold text-emerald-300 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-800">Best for Scaling Teams</span>
        </div>

        <!-- Model 3 -->
        <div class="bg-slate-800/80 p-8 rounded-3xl border border-slate-700 space-y-4">
          <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 font-mono">Option 03</span>
          <h3 class="font-serif text-xl font-bold text-white">UX Audit & Advisory</h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            2-week intensive diagnostic review of existing SaaS products, identifying usability bottlenecks and UI improvements.
          </p>
          <span class="inline-block text-xs font-semibold text-emerald-300 bg-emerald-950 px-3 py-1 rounded-full border border-emerald-800">Best for Existing SaaS</span>
        </div>
      </div>

      <div class="mt-12 text-center relative z-10">
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm transition-all duration-300 shadow-lg shadow-emerald-500/20"
        >
          <span>Discuss Custom Engagement</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
