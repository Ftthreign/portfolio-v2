---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProjects } from '../services/api';

const projects = await fetchProjects();
---

<BaseLayout title="Selected Work & Case Studies — Elian Ross" description="A curated collection of product design case studies, design systems, and web applications built by Elian Ross.">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-16">
    <!-- Header -->
    <div class="max-w-2xl mb-12 gsap-reveal">
      <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Portfolio</span>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 mt-2">
        Selected Work & Case Studies<span class="text-emerald-500">.</span>
      </h1>
      <p class="text-slate-600 text-base sm:text-lg mt-4 leading-relaxed">
        Deep dives into complex digital products, scalable component architectures, and user-centric interfaces.
      </p>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-12 gsap-reveal">
      <button class="px-5 py-2 rounded-full bg-slate-900 text-white text-xs sm:text-sm font-semibold shadow-sm">
        All Projects ({projects.length})
      </button>
      <button class="px-5 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs sm:text-sm font-medium transition-colors">
        Product Design
      </button>
      <button class="px-5 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs sm:text-sm font-medium transition-colors">
        Design Systems
      </button>
      <button class="px-5 py-2 rounded-full bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 text-xs sm:text-sm font-medium transition-colors">
        Web Applications
      </button>
    </div>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 gsap-stagger-parent">
      {projects.map((project) => (
        <article class="gsap-stagger-child bg-white rounded-3xl overflow-hidden border border-slate-200/80 shadow-card hover:shadow-hover hover:-translate-y-2 transition-all duration-300 flex flex-col group">
          <!-- Image Container -->
          <a href={`/projects/${project.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-100">
            <img
              src={project.cover_image_url}
              alt={project.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {project.category && (
              <span class="absolute top-4 left-4 px-3.5 py-1 rounded-full bg-white/90 backdrop-blur-md text-xs font-semibold text-slate-800 shadow-sm border border-white/60">
                {project.category}
              </span>
            )}
          </a>

          <!-- Details -->
          <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-xs font-semibold">
                <span class="text-emerald-600 uppercase tracking-wider">{project.client || 'Case Study'}</span>
                {project.year && <span class="text-slate-400 font-mono">{project.year}</span>}
              </div>

              <h2 class="font-serif text-2xl font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">
                <a href={`/projects/${project.slug}`}>{project.title}</a>
              </h2>

              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {project.short_description}
              </p>
            </div>

            <!-- Tech Stack & View Link -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-4">
              <div class="flex flex-wrap gap-1.5">
                {project.tech_stack.map((tech) => (
                  <span class="text-xs font-medium px-3 py-1 rounded-md bg-slate-100 text-slate-700">
                    {tech}
                  </span>
                ))}
              </div>

              <a
                href={`/projects/${project.slug}`}
                class="text-xs font-bold text-slate-900 group-hover:text-emerald-600 flex items-center gap-1 shrink-0 transition-colors"
              >
                <span>Read Case Study</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
