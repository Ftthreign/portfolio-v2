---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchProfile } from '../services/api';

const profile = await fetchProfile();

const experiences = [
  {
    period: '2024 — Present',
    role: 'Principal Product Designer & Digital Architect',
    company: 'Independent Practice',
    location: 'San Francisco / Remote',
    description: 'Advising venture-backed startups and cloud enterprises on scalable design system architecture, UI/UX strategy, and motion design.',
  },
  {
    period: '2022 — 2024',
    role: 'Lead Design Systems Architect',
    company: 'Apex Financial Technologies',
    location: 'San Francisco, CA',
    description: 'Architected enterprise token systems and component libraries powering 20+ financial applications, reducing engineering friction by 35%.',
  },
  {
    period: '2020 — 2022',
    role: 'Senior UI/UX Designer',
    company: 'Lumina Creative AI Labs',
    location: 'New York, NY',
    description: 'Designed human-in-the-loop AI workspaces and canvas interactions for over 150,000 active creative professionals.',
  },
  {
    period: '2017 — 2020',
    role: 'UI/UX Designer',
    company: 'Vanguard Digital Agency',
    location: 'Chicago, IL',
    description: 'Delivered high-impact digital design and web applications for Fortune 500 clients across fintech, healthtech, and ecommerce.',
  },
];
---

<BaseLayout title="About Elian Ross — Biography & Experience" description="Learn about Elian Ross, a Senior Product Designer & Digital Architect specializing in design systems and motion-rich digital experiences.">
  <section class="max-w-container mx-auto px-6 lg:px-12 pt-12 pb-24">
    <!-- Header Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-20 gsap-reveal">
      <div class="lg:col-span-7 space-y-6">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">About & Background</span>
        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-slate-900 leading-tight">
          Designing at the intersection of <span class="italic text-emerald-600 font-normal">utility</span>, system logic & visual delight<span class="text-emerald-500">.</span>
        </h1>
        <p class="text-slate-600 text-base sm:text-lg leading-relaxed">
          I'm Elian Ross, a Senior Product Designer & Digital Architect with over 8 years of experience building digital products for high-growth startups and global enterprises.
        </p>
        <p class="text-slate-600 text-base leading-relaxed">
          My work is rooted in systemic thinking—creating design frameworks that don't just look beautiful on Figma canvases, but translate seamlessly into production code and deliver measurable business outcomes.
        </p>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-6 py-3 rounded-full bg-slate-900 hover:bg-emerald-600 text-white text-sm font-semibold transition-colors"
          >
            Get in Touch
          </a>
          <a
            href="https://dribbble.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-white hover:bg-slate-100 text-slate-800 border border-slate-200 text-sm font-semibold transition-colors"
          >
            View Dribbble ↗
          </a>
        </div>
      </div>

      <!-- Avatar & Quick Facts Card -->
      <div class="lg:col-span-5 bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card space-y-6">
        <div class="aspect-square rounded-2xl overflow-hidden bg-slate-100 border border-slate-200/60">
          <img src={profile.avatar_url} alt={profile.name} class="w-full h-full object-cover" />
        </div>
        <div class="space-y-3 text-sm">
          <div class="flex justify-between border-b border-slate-100 pb-2">
            <span class="text-slate-400 font-semibold">Location</span>
            <span class="text-slate-900 font-bold">{profile.location}</span>
          </div>
          <div class="flex justify-between border-b border-slate-100 pb-2">
            <span class="text-slate-400 font-semibold">Specialization</span>
            <span class="text-emerald-600 font-bold">Design Systems & UI/UX</span>
          </div>
          <div class="flex justify-between border-b border-slate-100 pb-2">
            <span class="text-slate-400 font-semibold">Direct Email</span>
            <span class="text-slate-900 font-mono font-medium">{profile.email}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Design Philosophy -->
    <div class="mb-24">
      <div class="max-w-xl mb-12 gsap-reveal">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Principles</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mt-2">
          Design Philosophy<span class="text-emerald-500">.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 gsap-stagger-parent">
        <div class="gsap-stagger-child bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card space-y-4">
          <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">01</span>
          <h3 class="font-serif text-xl font-bold text-slate-900">System First, Screen Second</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Great products scale when built on disciplined token foundation and reusable UI patterns, not one-off screen designs.
          </p>
        </div>

        <div class="gsap-stagger-child bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card space-y-4">
          <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">02</span>
          <h3 class="font-serif text-xl font-bold text-slate-900">Motion is Functional</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Micro-interactions are not decoration—they establish spatial intuition, confirm user actions, and reduce perceived latency.
          </p>
        </div>

        <div class="gsap-stagger-child bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card space-y-4">
          <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">03</span>
          <h3 class="font-serif text-xl font-bold text-slate-900">Code Empathy</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Designing with a deep understanding of browser engines, React components, and Tailwind tokens leads to seamless engineering collaboration.
          </p>
        </div>
      </div>
    </div>

    <!-- Career Timeline -->
    <div class="max-w-4xl mx-auto">
      <div class="text-center max-w-xl mx-auto mb-16 gsap-reveal">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600">Career History</span>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-slate-900 mt-2">
          Experience Timeline<span class="text-emerald-500">.</span>
        </h2>
      </div>

      <div class="space-y-6 gsap-stagger-parent">
        {experiences.map((exp) => (
          <div class="gsap-stagger-child bg-white p-8 rounded-3xl border border-slate-200/80 shadow-card flex flex-col md:flex-row md:items-start justify-between gap-6 hover:border-emerald-300 transition-colors">
            <div class="md:w-1/3">
              <span class="text-xs font-bold text-emerald-600 uppercase tracking-wider font-mono">{exp.period}</span>
              <h3 class="font-serif text-xl font-bold text-slate-900 mt-1">{exp.role}</h3>
              <p class="text-slate-500 text-sm font-medium">{exp.company}</p>
            </div>
            <div class="md:w-2/3 space-y-2">
              <p class="text-slate-600 text-sm leading-relaxed">{exp.description}</p>
              <span class="inline-block text-xs font-mono text-slate-400">{exp.location}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
