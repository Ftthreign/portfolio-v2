---
const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: 'Home', href: '/', num: '01' },
  { name: 'About', href: '/about', num: '02' },
  { name: 'Projects', href: '/projects', num: '03' },
  { name: 'Services', href: '/services', num: '04' },
  { name: 'Certificate', href: '/certificate', num: '05' },
  { name: 'Blog', href: '/blog', num: '06' },
  { name: 'Contact', href: '/contact', num: '07' },
];

const socialLinks = [
  { name: 'GitHub', href: 'https://github.com' },
  { name: 'LinkedIn', href: 'https://linkedin.com' },
  { name: 'Instagram', href: 'https://instagram.com' },
];
---

<!-- Fixed Header Bar -->
<header class="fixed top-4 left-1/2 -translate-x-1/2 z-[100] w-[94%] max-w-container transition-all duration-300">
  <nav class="glass-nav rounded-full px-6 py-3 shadow-glass flex items-center justify-between border border-slate-200/80 dark:border-slate-800/80 dark:bg-slate-900/80">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group magnetic z-[100]">
      <span class="font-hero-serif italic text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-governor-bay-600 transition-colors">
        Ftthreign <span class="text-governor-bay-500 not-italic">.</span>
      </span>
    </a>

    <!-- Right Controls: Theme Toggle & Hamburger Menu Button -->
    <div class="flex items-center gap-3 z-[100]">
      <!-- Dark/Light Theme Toggle Button -->
      <button
        type="button"
        class="theme-toggle-btn magnetic p-2.5 rounded-full bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-amber-300 border border-slate-200 dark:border-slate-700 transition-all duration-300 cursor-pointer shadow-sm"
        aria-label="Toggle Theme"
        title="Toggle Dark / Light Mode"
      >
        <!-- Sun Icon (visible in Dark Mode) -->
        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
        <!-- Moon Icon (visible in Light Mode) -->
        <svg class="w-4 h-4 block dark:hidden text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
      </button>

      <!-- Hamburger Toggle Button -->
      <button
        type="button"
        class="nav-menu-btn magnetic flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-slate-900 dark:bg-white hover:bg-governor-bay-600 dark:hover:bg-governor-bay-500 text-white dark:text-slate-900 font-medium text-xs sm:text-sm shadow-md hover:shadow-hover transition-all duration-300 cursor-pointer"
        aria-label="Toggle Menu"
      >
        <span class="nav-menu-label font-hero-sans font-semibold">Menu</span>
        <div class="w-4 h-3 flex flex-col justify-between items-center relative">
          <span class="hamburger-line-top w-4 h-[2px] bg-white dark:bg-slate-900 rounded-full transition-transform origin-center"></span>
          <span class="hamburger-line-bottom w-4 h-[2px] bg-white dark:bg-slate-900 rounded-full transition-transform origin-center"></span>
        </div>
      </button>
    </div>
  </nav>
</header>

<!-- Full-Screen Interactive Overlay (Vice-Versa Theme Inverted) -->
<div
  class="nav-fullscreen-overlay fixed inset-0 z-[90] bg-slate-950/95 backdrop-blur-2xl text-slate-100 flex flex-col justify-between p-6 sm:p-12 lg:p-16 pointer-events-none select-none overflow-y-auto transition-colors duration-500"
  style="clip-path: circle(0px at 90% 4%);"
>
  <!-- Ambient Radial Governor Bay Glow Backdrop -->
  <div class="absolute top-1/3 left-1/3 w-[650px] h-[650px] bg-governor-bay-600/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <!-- Overlay Header Spacer -->
  <div class="h-16 w-full shrink-0"></div>

  <!-- Overlay Content Layout -->
  <div class="max-w-container mx-auto w-full flex-1 flex flex-col lg:flex-row justify-between items-center gap-12 py-6 my-auto">
    <!-- Left Column: Borderless Interactive Editorial Menu Links -->
    <div class="flex flex-col gap-2 sm:gap-4 w-full lg:w-3/5">
      <div class="flex items-center gap-3 mb-2">
        <p class="text-xs font-bold tracking-widest uppercase font-hero-sans opacity-80">
          Navigation
        </p>
      </div>

      {navItems.map((item) => {
        const isActive = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
        return (
          <a
            href={item.href}
            class="nav-overlay-link group flex items-center justify-between py-2 px-1 rounded-xl border-0 outline-none transition-all duration-300"
          >
            <div class="flex items-baseline gap-4 sm:gap-6 font-hero-serif italic text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-normal leading-tight">
              <!-- Index Number -->
              <span class="text-xs sm:text-sm font-hero-sans not-italic font-bold opacity-60 group-hover:opacity-100 transition-opacity">
                {item.num}
              </span>

              <!-- Menu Text -->
              <span class={`flex items-center gap-3 transition-all duration-300 ${
                isActive
                  ? 'font-bold tracking-wide translate-x-2'
                  : 'group-hover:translate-x-4 sm:group-hover:translate-x-6'
              }`}>
                <span>{item.name}</span>
              </span>
            </div>

            <!-- Interactive Hover Arrow Indicator -->
            <span class={`font-hero-sans not-italic transition-all duration-300 ${
              isActive
                ? 'opacity-100 text-governor-bay-500 text-xl sm:text-3xl translate-x-0'
                : 'opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 text-xl sm:text-3xl'
            }`}>
              →
            </span>
          </a>
        );
      })}
    </div>

    <div class="hidden lg:flex flex-col gap-8 w-2/5 border-l border-slate-700/30 pl-16 shrink-0">

      <div class="nav-overlay-info space-y-2">
        <p class="text-xs font-bold tracking-widest opacity-60 uppercase font-hero-sans">
          Get in Touch
        </p>
        <a href="mailto:fadhilfattah4393@gmail.com" class="block font-hero-sans text-lg sm:text-xl font-bold hover:text-governor-bay-500 transition-colors">
          fadhilfattah4393@gmail.com
        </a>
        <p class="text-xs opacity-70 font-hero-sans">
          Based in Indonesia 
        </p>
      </div>

      <!-- Social Links -->
      <div class="nav-overlay-info space-y-3">
        <p class="text-xs font-bold tracking-widest opacity-60 uppercase font-hero-sans">
          Social Connect
        </p>
        <div class="flex flex-wrap gap-3">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-full bg-slate-900/80 dark:bg-white/80 border border-slate-700/40 text-xs font-medium text-white dark:text-slate-900 hover:opacity-80 transition-all duration-200 font-hero-sans"
            >
              {s.name} ↗
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Overlay Footer -->
  <div class="max-w-container mx-auto w-full flex flex-col sm:flex-row justify-between items-center border-t border-slate-800/40 pt-6 text-xs opacity-60 font-hero-sans shrink-0 gap-2">
    <span>© 2025 Fadhil Abdul Fattah. All rights reserved.</span>
    <span>Press <kbd class="px-2 py-1 rounded bg-slate-900 dark:bg-slate-200 text-white dark:text-slate-900 text-[10px]">ESC</kbd> to exit menu</span>
  </div>
</div>

<!-- Client Script -->
<script>
  import { initFullScreenNavbar, initThemeToggle } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    initThemeToggle();
    initFullScreenNavbar();
  });

  document.addEventListener('astro:page-load', () => {
    initThemeToggle();
    initFullScreenNavbar();
  });
</script>
