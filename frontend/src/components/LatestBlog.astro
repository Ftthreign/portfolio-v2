---
import type { BlogPost } from '../services/api';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<section class="latest-blog-section max-w-container mx-auto px-6 lg:px-12 py-12 sm:py-20 relative select-none">
  <!-- Section Header -->
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 gap-4 sm:gap-6 pb-4 sm:pb-6 border-b border-slate-200/80 dark:border-slate-800/80 gsap-reveal">
    <div class="space-y-1.5 sm:space-y-2">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-governor-bay-500"></span>
        <span class="text-[11px] sm:text-xs font-bold uppercase tracking-widest text-governor-bay-600 dark:text-governor-bay-400 font-hero-sans">
          Journal & Thought Leadership
        </span>
      </div>
      <h2 class="font-hero-serif italic text-2xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white">
        Writing & Insights<span class="text-governor-bay-500 not-italic">.</span>
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm max-w-xl font-hero-sans pt-0.5 sm:pt-1 leading-relaxed">
        Articles on design systems, software architecture, motion UI, and front-end engineering craftsmanship.
      </p>
    </div>

    <a
      href="/blog"
      class="text-slate-900 dark:text-white font-semibold hover:text-governor-bay-600 dark:hover:text-governor-bay-400 text-xs sm:text-sm flex items-center gap-2 transition-colors font-hero-sans shrink-0 group pt-1 md:pt-0"
    >
      <span>Explore All Articles ({posts.length})</span>
      <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
    </a>
  </div>

  <!-- Text-First Editorial List Rows (Responsive Mobile Typography) -->
  <div class="space-y-1">
    {posts.map((post, idx) => (
      <a
        href={`/blog/${post.slug}`}
        data-cover-url={post.cover_image_url}
        class="blog-editorial-row group block relative border-b border-slate-200/80 dark:border-slate-800/80 py-4 sm:py-8 px-3 sm:px-4 -mx-3 sm:-mx-4 rounded-xl sm:rounded-2xl transition-colors hover:bg-slate-100/60 dark:hover:bg-slate-800/40"
      >
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5 sm:gap-4">
          <!-- Left: Number Index & Article Title -->
          <div class="flex items-start md:items-center gap-3 sm:gap-6 flex-1 min-w-0">
            <span class="font-mono text-[11px] sm:text-sm font-semibold text-slate-400 dark:text-slate-500 shrink-0 pt-0.5 md:pt-0">
              0{idx + 1}
            </span>
            <h3 class="blog-row-title font-hero-serif italic text-base sm:text-2xl lg:text-3xl font-bold text-slate-900 dark:text-white transition-colors group-hover:text-governor-bay-600 dark:group-hover:text-governor-bay-400 truncate">
              {post.title}
            </h3>
          </div>

          <!-- Right: Reading Time & Hover Arrow -->
          <div class="flex items-center justify-between md:justify-end gap-3 sm:gap-6 shrink-0 pt-1 md:pt-0">
            <span class="text-[11px] sm:text-xs font-mono text-slate-400 dark:text-slate-500 font-medium">
              {post.reading_time_minutes} min read
            </span>

            <span class="blog-row-arrow text-slate-400 dark:text-slate-500 group-hover:text-governor-bay-600 dark:group-hover:text-white font-bold text-sm sm:text-lg transition-colors">
              →
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>

  <!-- GSAP Desktop Floating Cover Image Preview Modal (Follows Cursor on Row Hover) -->
  <div class="blog-floating-preview fixed top-0 left-0 w-72 h-44 rounded-2xl overflow-hidden shadow-2xl pointer-events-none z-50 opacity-0 scale-85 border border-white/50 dark:border-slate-800 hidden lg:block bg-slate-900">
    <img src="" alt="Article Preview" class="blog-floating-img w-full h-full object-cover" />
  </div>
</section>

<!-- Client Script to Initialize Blog Row Animation Controller -->
<script>
  import { initBlogRowAnimations } from '../utils/gsap';

  document.addEventListener('DOMContentLoaded', () => {
    initBlogRowAnimations();
  });

  document.addEventListener('astro:page-load', () => {
    initBlogRowAnimations();
  });
</script>
