---
import ThemeToggle from './ThemeToggle.astro';
---

<!-- Mobile Menu Trigger Button (Visible on < md screens) -->
<div class="flex items-center gap-2 md:hidden">
  <ThemeToggle />
  <button
    id="mobile-menu-trigger"
    type="button"
    aria-label="Toggle Mobile Menu"
    class="btn-paper text-xs uppercase font-mono tracking-widest font-bold px-3 py-1.5 rounded-none transition-all"
  >
    <span id="mobile-menu-text">[ MENU ]</span>
  </button>
</div>

<!-- Mobile Menu Fullscreen Overlay Drawer -->
<div
  id="mobile-menu-overlay"
  class="fixed left-0 right-0 top-16 bottom-0 w-screen h-[calc(100dvh-4rem)] z-[99999] bg-paper dark:bg-dark-paper border-t border-black dark:border-dark-border hidden flex-col justify-between p-6 sm:p-8 font-mono overflow-y-auto"
>
  <nav class="space-y-4 pt-4">
    <div class="text-[10px] uppercase font-mono tracking-widest text-acid dark:text-dark-acid font-bold border-b border-black/20 dark:border-dark-border pb-2">
      SYS.NAVIGATION // NAVIGASI UTAMA
    </div>
    <a href="/#about" class="mobile-nav-link block font-mono text-xl sm:text-2xl font-bold text-ink dark:text-dark-ink hover:text-acid dark:hover:text-dark-acid transition-colors py-2 border-b border-black/10 dark:border-dark-border/30">
      01 // TENTANG
    </a>
    <a href="/projects" class="mobile-nav-link block font-mono text-xl sm:text-2xl font-bold text-ink dark:text-dark-ink hover:text-acid dark:hover:text-dark-acid transition-colors py-2 border-b border-black/10 dark:border-dark-border/30">
      02 // PROYEK
    </a>
    <a href="/blog" class="mobile-nav-link block font-mono text-xl sm:text-2xl font-bold text-ink dark:text-dark-ink hover:text-acid dark:hover:text-dark-acid transition-colors py-2 border-b border-black/10 dark:border-dark-border/30">
      03 // BLOG
    </a>
    <a href="/#skills" class="mobile-nav-link block font-mono text-xl sm:text-2xl font-bold text-ink dark:text-dark-ink hover:text-acid dark:hover:text-dark-acid transition-colors py-2 border-b border-black/10 dark:border-dark-border/30">
      04 // KEAHLIAN
    </a>
    <a href="/#contact" class="mobile-nav-link block font-mono text-xl sm:text-2xl font-bold text-ink dark:text-dark-ink hover:text-acid dark:hover:text-dark-acid transition-colors py-2 border-b border-black/10 dark:border-dark-border/30">
      05 // KONTAK
    </a>
  </nav>

  <div id="mobile-menu-footer" class="pt-6 border-t border-black dark:border-dark-border space-y-4">
    <p class="text-[10px] text-center font-mono text-muted dark:text-dark-muted">
      KINETIC MONO v2.0 // FULLSTACK PORTFOLIO
    </p>
  </div>
</div>

<script>
  import { gsap } from '../utils/gsap';

  function setupMobileMenu() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const menuText = document.getElementById('mobile-menu-text');
    const overlay = document.getElementById('mobile-menu-overlay');
    const links = document.querySelectorAll('.mobile-nav-link');
    const footerArea = document.getElementById('mobile-menu-footer');

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      if (!overlay || !menuText) return;

      menuText.textContent = '[ CLOSE ]';
      document.body.style.overflow = 'hidden';
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');

      // GSAP Entrance Animation (Overlay Fade & Slide, Staggered Nav Links)
      gsap.fromTo(
        overlay,
        { opacity: 0, y: -15 },
        { opacity: 1, y: 0, duration: 0.3, ease: 'power3.out' }
      );

      gsap.fromTo(
        links,
        { opacity: 0, x: -20 },
        {
          opacity: 1,
          x: 0,
          duration: 0.35,
          stagger: 0.06,
          ease: 'power2.out',
          delay: 0.05,
        }
      );

      if (footerArea) {
        gsap.fromTo(
          footerArea,
          { opacity: 0, y: 15 },
          { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', delay: 0.2 }
        );
      }
    }

    function closeMenu() {
      isOpen = false;
      if (!overlay || !menuText) return;

      menuText.textContent = '[ MENU ]';
      document.body.style.overflow = '';

      // GSAP Exit Animation
      gsap.to(overlay, {
        opacity: 0,
        y: -15,
        duration: 0.25,
        ease: 'power2.in',
        onComplete: () => {
          overlay.classList.add('hidden');
          overlay.classList.remove('flex');
        },
      });
    }

    trigger?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    links.forEach((link) => {
      link.addEventListener('click', () => {
        if (isOpen) closeMenu();
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
