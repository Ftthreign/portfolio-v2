---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items = [] } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-8 font-hero-sans text-xs sm:text-sm">
  <ol class="inline-flex items-center space-x-2 sm:space-x-3 text-slate-500 dark:text-slate-400 flex-wrap gap-y-1">
    <li class="inline-flex items-center">
      <a href="/" class="hover:text-governor-bay-600 dark:hover:text-white transition-colors flex items-center gap-1.5 font-medium">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span>Home</span>
      </a>
    </li>

    {items.map((item, idx) => {
      const isLast = idx === items.length - 1;
      return (
        <li class="flex items-center min-w-0" aria-current={isLast ? 'page' : undefined}>
          <span class="text-slate-300 dark:text-slate-600 select-none">/</span>
          {isLast || !item.href ? (
            <span class="ml-2 sm:ml-3 font-semibold text-slate-900 dark:text-white truncate max-w-[180px] sm:max-w-xs md:max-w-md">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="ml-2 sm:ml-3 hover:text-governor-bay-600 dark:hover:text-white transition-colors font-medium">
              {item.label}
            </a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
