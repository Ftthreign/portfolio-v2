---
---

<section class="max-w-container mx-auto px-4 sm:px-6 lg:px-12 py-16 sm:py-24 overflow-hidden w-full max-w-full">
  <div class="bg-slate-900 dark:bg-slate-950 text-white rounded-[2.5rem] p-8 sm:p-14 relative overflow-hidden shadow-2xl border border-slate-800 transition-colors duration-400">
    <!-- Ambient Radial Glow Backdrop -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-governor-bay-600/15 rounded-full blur-[120px] pointer-events-none -z-0"></div>

    <div class="max-w-xl mb-12 relative z-10">
      <span class="text-xs font-bold uppercase tracking-widest text-governor-bay-400 font-hero-sans">Core Services</span>
      <h2 class="font-hero-serif italic text-3xl sm:text-4xl font-bold text-white mt-2">
        Specialized design capabilities tailored for growth<span class="text-governor-bay-400 not-italic">.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
      <!-- Service 1 -->
      <div class="bg-slate-800/80 dark:bg-slate-900/80 p-8 rounded-3xl border border-slate-700/80 dark:border-slate-800/80 space-y-4">
        <div class="w-10 h-10 rounded-2xl bg-governor-bay-500/20 text-governor-bay-300 flex items-center justify-center font-bold font-hero-sans">
          01
        </div>
        <h3 class="font-hero-serif italic text-xl font-bold text-white">Product UI/UX Design</h3>
        <p class="text-slate-300 text-sm leading-relaxed font-hero-sans">
          End-to-end web & mobile user interface design, user journey optimization, and wireframing for complex SaaS applications.
        </p>
      </div>

      <!-- Service 2 -->
      <div class="bg-slate-800/80 dark:bg-slate-900/80 p-8 rounded-3xl border border-slate-700/80 dark:border-slate-800/80 space-y-4">
        <div class="w-10 h-10 rounded-2xl bg-governor-bay-500/20 text-governor-bay-300 flex items-center justify-center font-bold font-hero-sans">
          02
        </div>
        <h3 class="font-hero-serif italic text-xl font-bold text-white">Design Systems & Tokens</h3>
        <p class="text-slate-300 text-sm leading-relaxed font-hero-sans">
          Multi-platform token architectures, component libraries in Figma & React, and comprehensive documentation for dev teams.
        </p>
      </div>

      <!-- Service 3 -->
      <div class="bg-slate-800/80 dark:bg-slate-900/80 p-8 rounded-3xl border border-slate-700/80 dark:border-slate-800/80 space-y-4">
        <div class="w-10 h-10 rounded-2xl bg-governor-bay-500/20 text-governor-bay-300 flex items-center justify-center font-bold font-hero-sans">
          03
        </div>
        <h3 class="font-hero-serif italic text-xl font-bold text-white">Motion & Interactive Prototypes</h3>
        <p class="text-slate-300 text-sm leading-relaxed font-hero-sans">
          GSAP & Lottie micro-interactions, scroll-triggered storytelling, and high-fidelity prototypes that drive user engagement.
        </p>
      </div>
    </div>

    <div class="mt-12 text-center relative z-10">
      <a
        href="/services"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-governor-bay-600 hover:bg-governor-bay-500 text-white font-bold text-sm transition-all duration-300 shadow-md font-hero-sans"
      >
        <span>View All Offerings & Deliverables</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
