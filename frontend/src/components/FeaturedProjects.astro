---
import type { Project } from '../services/api';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<section class="max-w-container mx-auto px-6 lg:px-12 py-12">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4 gsap-reveal">
    <div>
      <span class="text-xs font-bold uppercase tracking-widest text-governor-bay-600 dark:text-governor-bay-400 font-hero-sans">Selected Portfolio</span>
      <h2 class="font-hero-serif italic text-3xl sm:text-4xl font-bold text-slate-900 dark:text-white mt-2">
        Featured Case Studies<span class="text-governor-bay-500 not-italic">.</span>
      </h2>
    </div>
    <a href="/work" class="text-slate-900 dark:text-white font-semibold hover:text-governor-bay-600 dark:hover:text-governor-bay-400 text-sm flex items-center gap-1.5 transition-colors font-hero-sans">
      <span>View All Projects ({projects.length})</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
      </svg>
    </a>
  </div>

  <!-- Project Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 gsap-stagger-parent">
    {projects.map((project) => (
      <article class="gsap-stagger-child bg-white dark:bg-slate-900/90 rounded-3xl overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-card hover:shadow-hover hover:-translate-y-2 transition-all duration-300 flex flex-col group">
        <!-- Image Wrapper with Hover Zoom -->
        <a href={`/projects/${project.slug}`} class="block relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
          <img
            src={project.cover_image_url}
            alt={project.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
          {project.category && (
            <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur-md text-xs font-semibold text-slate-800 dark:text-slate-200 shadow-sm border border-white/50 dark:border-slate-800 font-hero-sans">
              {project.category}
            </span>
          )}
        </a>

        <!-- Project Info -->
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-governor-bay-600 dark:text-governor-bay-400 uppercase tracking-wider font-hero-sans">{project.client || 'Featured Case Study'}</span>
              {project.year && <span class="text-xs text-slate-400 dark:text-slate-500 font-mono">{project.year}</span>}
            </div>
            <h3 class="font-hero-serif italic text-xl font-bold text-slate-900 dark:text-white group-hover:text-governor-bay-600 dark:group-hover:text-governor-bay-300 transition-colors">
              <a href={`/projects/${project.slug}`}>{project.title}</a>
            </h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed line-clamp-2 font-hero-sans">
              {project.short_description}
            </p>
          </div>

          <!-- Tech Tags -->
          <div class="pt-2 flex flex-wrap gap-1.5 border-t border-slate-100 dark:border-slate-800">
            {project.tech_stack.slice(0, 4).map((tech) => (
              <span class="text-[11px] font-medium px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-hero-sans">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
